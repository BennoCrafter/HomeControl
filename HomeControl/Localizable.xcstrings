        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HomeControl braucht Zugriff auf deine Home-Daten, um dein Zubehör anzuzeigen und zu steuern. Sie bleiben zwischen deinen Geräten und Apple Home."
          }
        }
      }
    },
    "HomeControl reads and controls your accessories through Apple Home." : {
      "localizations" : {
